  ownerType  String
  ownerId    String
  kind       String
  label      String
  required   Boolean  @default(true)
  url        String   @default("")
  uploadedBy String?
  uploader   User?    @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId, ownerType, ownerId])
}

model CommunicationLog {
