generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  PUBLIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  LEAVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum FeeStructureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum LateFeeMode {
  NONE
  FIXED
  DAILY
  PERCENT
}

enum PaymentStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum CreditStatus {
  AVAILABLE
  PARTIALLY_USED
  USED
  REFUNDED
}

enum FbrStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum MediaKind {
  LOGO
  COVER
  PHOTO
  VIDEO
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSESSMENT_PENDING
  INTERVIEW_PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  FEE_PENDING
  DOCUMENTS_PENDING
  ADMISSION_CONFIRMED
  WITHDRAWN
}

enum AssessmentMode {
  NONE
  TEST
  INTERVIEW
  BOTH
}

enum CommunicationType {
  NOTE
  MEETING
  EMAIL
  SMS
  NOTIFICATION
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  name       String
  role       Role      @default(PARENT)
  schoolId   String?
  school     School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  disabled   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resets     PasswordReset[]
  claims     SchoolClaim[]
  invites    Invite[]  @relation("Inviter")
  accepted   Invite[]  @relation("AcceptedBy")
  audits     AuditLog[]
  memberships CampusMembership[]
  documents  SchoolDocument[] @relation("DocumentUploader")
  notes      CommunicationLog[] @relation("CommunicationAuthor")
  applications AdmissionApplication[] @relation("ApplicationCreator")
  collectedPayments Payment[] @relation("PaymentCollector")
  generatedReceipts Receipt[] @relation("ReceiptGenerator")
  staff      Staff?

  @@index([schoolId])
}

model School {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  city        String
  area        String    @default("")
  type        String    @default("private")
  whatsapp    String    @default("")
  phone       String    @default("")
  website     String    @default("")
  address     String    @default("")
  email       String    @default("")
  province    String    @default("")
  country     String    @default("Pakistan")
  registrationNo String @default("")
  taxNumber   String    @default("")
  ntn         String    @default("")
  strn        String    @default("")
  primaryColor String   @default("#4642ff")
  educationLevel String @default("")
  feeBand     String    @default("10k_20k")
  levels      Json      @default("[]")
  claimStatus String    @default("UNCLAIMED")
  l2Active    Boolean   @default(false)
  setupCompleted Boolean @default(false)
  setupStep   Int       @default(1)
  published   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  profile     SchoolProfile?
  posts       SchoolPost[]
  reviews     SchoolReview[]
  media       SchoolMedia[]
  years       AcademicYear[]
  classes     Class[]
  students    Student[]
  guardians   Guardian[]
  staff       Staff[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  feePlans    FeePlan[]
  feeHeads    FeeHead[]
  feeStructures FeeStructure[]
  feeAssignments StudentFeeAssignment[]
  discounts   Discount[]
  studentDiscounts StudentDiscount[]
  feeSettings SchoolFeeSettings?
  invoices    Invoice[]
  payments    Payment[]
  receipts    Receipt[]
  credits     StudentCredit[]
  fbrInvoices FbrInvoice[]
  campuses    Campus[]
  subjects    Subject[]
  classSubjects ClassSubject[]
  admissionForms AdmissionForm[]
  feeItems    FeeItem[]
  memberships CampusMembership[]
  claims      SchoolClaim[]
  invites     Invite[]
  periods     TimetablePeriod[]
  lessons     TimetableLesson[]
  assignments TeacherAssignment[]
  audits      AuditLog[]
  exams       Exam[]
  applications AdmissionApplication[]
  documents    SchoolDocument[]
  communications CommunicationLog[]
  sequences    SchoolSequence[]
  staffContracts StaffContract[]
  staffStatusChanges StaffStatusChange[]
  payslips     Payslip[]
}

model SchoolProfile {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  about           String
  location        String
  principal       String
  establishedYear Int
  studentCount    Int
  teacherCount    Int
  facilities      Json
  labs            Json
  sports          Json
  activities      Json
  programs        Json
  feeMinPkr       Int
  feeMaxPkr       Int
  feeNotes        String
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SchoolPost {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolReview {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author    String
  roleLabel String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolMedia {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind      MediaKind
  url       String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startsOn  DateTime
  endsOn    DateTime
  current   Boolean   @default(false)
  classes   Class[]
  feePlans  FeePlan[]
  feeStructures FeeStructure[]
  invoices  Invoice[]
  exams     Exam[]
  applications AdmissionApplication[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

model Class {
  id          String              @id @default(cuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId      String
  year        AcademicYear        @relation(fields: [yearId], references: [id], onDelete: Cascade)
  campusId    String?
  campus      Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  name        String
  section     String              @default("A")
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  assignments TeacherAssignment[]
  lessons     TimetableLesson[]
  subjects    ClassSubject[]
  applications AdmissionApplication[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([schoolId, yearId, campusId, name, section])
  @@index([schoolId])
  @@index([campusId])
}

model Student {
  id                 String              @id @default(cuid())
  schoolId           String
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId           String?
  campus             Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  admissionNo        String
  rollNo             String              @default("")
  firstName          String
  lastName           String
  gender             String
  dateOfBirth        DateTime?
  status             String              @default("active")
  admissionDate      DateTime            @default(now())
  firstAdmissionDate DateTime            @default(now())
  extra              Json                @default("{}")
  enrollments        Enrollment[]
  attendance         AttendanceRecord[]
  invoices           Invoice[]
  payments           Payment[]
  receipts           Receipt[]
  feeAssignments     StudentFeeAssignment[]
  studentDiscounts   StudentDiscount[]
  credits            StudentCredit[]
  guardians          StudentGuardian[]
  examResults        ExamResult[]
  applications       AdmissionApplication[]
  communications     CommunicationLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([campusId])
  @@index([schoolId, rollNo])
}

model Guardian {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  cnic      String            @default("")
  email     String?
  relation  String
  extra     Json              @default("{}")
  occupation String           @default("")
  students  StudentGuardian[]
  applications AdmissionApplication[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([schoolId])
  @@index([schoolId, phone])
  @@index([schoolId, cnic])
}

model StudentGuardian {
  studentId  String
  guardianId String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum ContractType {
  PERMANENT
  CONTRACT
  PROBATION
  PART_TIME
  VISITING
}

enum PayslipStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

/// Name and CNIC are fixed once saved; staff are never deleted — change their status instead.
model Staff {
  id               String              @id @default(cuid())
  schoolId         String
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId         String?
  campus           Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  userId           String?             @unique
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeNo       String              @default("")
  name             String
  cnic             String              @default("")
  gender           String              @default("")
  dateOfBirth      DateTime?
  address          String              @default("")
  title            String
  department       String              @default("")
  joinDate         DateTime?
  status           StaffStatus         @default(ACTIVE)
  email            String?
  phone            String              @default("")
  bankName         String              @default("")
  bankAccountTitle String              @default("")
  bankAccountNo    String              @default("")
  subjects         Json                @default("[]")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assignments      TeacherAssignment[]
  lessons          TimetableLesson[]
  contracts        StaffContract[]
  statusChanges    StaffStatusChange[]
  payslips         Payslip[]

  @@index([schoolId])
  @@index([schoolId, cnic])
  @@index([schoolId, status])
}

model StaffContract {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type           ContractType @default(PERMANENT)
  startDate      DateTime
  endDate        DateTime?
  basicSalaryPkr Int          @default(0)
  /// [{ label, amountPkr }] paid every month on top of the basic salary.
  allowances     Json         @default("[]")
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId])
  @@index([staffId])
}

model StaffStatusChange {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  fromStatus  StaffStatus
  toStatus    StaffStatus
  reason      String      @default("")
  effectiveOn DateTime
  actorId     String?
  createdAt   DateTime    @default(now())

  @@index([staffId])
}

model Payslip {
  id           String        @id @default(cuid())
  schoolId     String
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId      String
  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  /// "YYYY-MM"
  period       String
  payslipNo    String        @default("")
  basicPkr     Int           @default(0)
  /// [{ label, amountPkr }]
  allowances   Json          @default("[]")
  /// [{ label, amountPkr }]
  deductions   Json          @default("[]")
  grossPkr     Int           @default(0)
  deductionPkr Int           @default(0)
  netPkr       Int           @default(0)
  status       PayslipStatus @default(DRAFT)
  paidOn       DateTime?
  method       String        @default("")
  reference    String        @default("")
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([staffId, period])
  @@index([schoolId, period])
}

model Enrollment {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId      String
  class        Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  rollNo       String    @default("")
  status       String    @default("active")
  studentType  String    @default("new")
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId])
  @@index([studentId])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, date])
}

model FeePlan {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId    String
  year      AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  name      String
  amountPkr Int
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

model FeeHead {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId    String?
  campus      Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  name        String
  code        String        @default("")
  category    String        @default("tuition")
  frequency   FeeFrequency  @default(MONTHLY)
  recurring   Boolean       @default(true)
  taxable     Boolean       @default(false)
  description String        @default("")
  active      Boolean       @default(true)
  amountPkr   Int           @default(0)
  sortOrder   Int           @default(0)
  items       FeeStructureItem[]
  invoiceItems InvoiceItem[]
  overrides   StudentFeeOverride[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId])
  @@index([schoolId, code])
}

model FeeStructure {
  id              String              @id @default(cuid())
  schoolId        String
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String?
  campus          Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYearId  String
  year            AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name            String
  className       String              @default("")
  section         String              @default("")
  frequency       FeeFrequency        @default(MONTHLY)
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  status          FeeStructureStatus  @default(DRAFT)
  notes           String              @default("")
  items           FeeStructureItem[]
  assignments     StudentFeeAssignment[]
  invoices        Invoice[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([schoolId])
  @@index([schoolId, academicYearId, className])
}

model FeeStructureItem {
  id              String        @id @default(cuid())
  feeStructureId  String
  structure       FeeStructure  @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHeadId       String
  feeHead         FeeHead       @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
  amountPkr       Int
  isOptional      Boolean       @default(false)
  taxable         Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([feeStructureId])
}

model StudentFeeAssignment {
  id              String            @id @default(cuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId  String
  feeStructureId  String
  structure       FeeStructure      @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  effectiveFrom   DateTime
  effectiveUntil  DateTime?
  status          AssignmentStatus  @default(ACTIVE)
  notes           String            @default("")
  overrides       StudentFeeOverride[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([schoolId, studentId])
  @@index([feeStructureId])
}

model StudentFeeOverride {
  id            String                @id @default(cuid())
  assignmentId  String
  assignment    StudentFeeAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  feeHeadId     String
  feeHead       FeeHead               @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
  amountPkr     Int?
  enabled       Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([assignmentId, feeHeadId])
}

model Discount {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  type        DiscountType
  value       Int
  feeHeadIds  Json          @default("[]")
  classNames  Json          @default("[]")
  active      Boolean       @default(true)
  students    StudentDiscount[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId])
}

model StudentDiscount {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discountId  String?
  discount    Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  name        String
  type        DiscountType
  value       Int
  feeHeadIds  Json      @default("[]")
  active      Boolean   @default(true)
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, studentId])
}

model SchoolFeeSettings {
  id                  String      @id @default(cuid())
  schoolId            String      @unique
  school              School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  defaultDueDay       Int         @default(10)
  graceDays           Int         @default(0)
  autoGenerateEnabled Boolean     @default(false)
  lateFeeMode         LateFeeMode @default(NONE)
  lateFeeAmountPkr    Int         @default(0)
  lateFeePercent      Int         @default(0)
  lateFeeCapPkr       Int         @default(0)
  invoicePrefix       String      @default("INV")
  paymentPrefix       String      @default("PAY")
  receiptPrefix       String      @default("REC")
  receiptHeader       String      @default("")
  receiptFooter       String      @default("Thank you for your payment.")
  showTaxOnReceipt    Boolean     @default(false)
  fbrEnabled          Boolean     @default(false)
  fbrEnvironment      String      @default("sandbox")
  fbrCredentialsEnc   String      @default("")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Invoice {
  id                String                 @id @default(cuid())
  schoolId          String
  school            School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId          String?
  campus            Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  studentId         String?
  student           Student?               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationId     String?
  application       AdmissionApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  academicYearId    String?
  year              AcademicYear?          @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  feeStructureId    String?
  feeStructure      FeeStructure?          @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  feePlanId         String?
  feePlan           FeePlan?               @relation(fields: [feePlanId], references: [id], onDelete: Restrict)
  invoiceNumber     String                 @default("")
  billingPeriod     String                 @default("")
  issueDate         DateTime               @default(now())
  dueOn             DateTime
  dueDate           DateTime?
  subtotalPkr       Int                    @default(0)
  discountAmountPkr Int                    @default(0)
  lateFeeAmountPkr  Int                    @default(0)
  taxAmountPkr      Int                    @default(0)
  totalAmountPkr    Int                    @default(0)
  paidAmountPkr     Int                    @default(0)
  balanceAmountPkr  Int                    @default(0)
  amountPkr         Int
  status            InvoiceStatus          @default(ISSUED)
  notes             String                 @default("")
  payments          Payment[]
  allocations       PaymentAllocation[]
  items             InvoiceItem[]
  fbrInvoice        FbrInvoice?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([applicationId])
  @@index([schoolId, billingPeriod])
  @@index([schoolId, invoiceNumber])
}

model InvoiceItem {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHeadId         String?
  feeHead           FeeHead?  @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
  description       String
  quantity          Int       @default(1)
  unitAmountPkr     Int
  grossAmountPkr    Int
  discountAmountPkr Int       @default(0)
  taxAmountPkr      Int       @default(0)
  netAmountPkr      Int
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([invoiceId])
}

model Payment {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId        String?
  campus          Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  studentId       String?
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentNumber   String          @default("")
  paymentDate     DateTime        @default(now())
  amountPkr       Int
  method          String
  referenceNumber String          @default("")
  notes           String          @default("")
  collectedById   String?
  collectedBy     User?           @relation("PaymentCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  status          PaymentStatus   @default(COMPLETED)
  receiptNo       String
  requestId       String?
  paidAt          DateTime        @default(now())
  allocations     PaymentAllocation[]
  receipt         Receipt?
  credits         StudentCredit[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([schoolId, requestId])
  @@unique([schoolId, receiptNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, paymentNumber])
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountPkr   Int
  createdAt   DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model StudentCredit {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourcePaymentId   String?
  sourcePayment     Payment?      @relation(fields: [sourcePaymentId], references: [id], onDelete: SetNull)
  amountPkr         Int
  remainingAmountPkr Int
  status            CreditStatus  @default(AVAILABLE)
  reason            String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([schoolId, studentId])
}

model Receipt {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receiptNumber String
  receiptDate   DateTime @default(now())
  amountPkr     Int
  previousBalancePkr  Int @default(0)
  remainingBalancePkr Int @default(0)
  generatedById String?
  generatedBy   User?    @relation("ReceiptGenerator", fields: [generatedById], references: [id], onDelete: SetNull)
  pdfPath       String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
}

model FbrInvoice {
  id               String    @id @default(cuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceId        String    @unique
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fbrInvoiceNumber String?
  fbrStatus        FbrStatus @default(NOT_REQUIRED)
  qrCodeData       String?
  submissionDate   DateTime?
  responseData     Json?
  errorMessage     String?
  environment      String    @default("sandbox")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([schoolId])
}

model Campus {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  address      String   @default("")
  phone        String   @default("")
  principal    String   @default("")
  code         String   @default("MAIN")
  isMain       Boolean  @default(false)
  notes        String   @default("")
  classes      Class[]
  students     Student[]
  memberships  CampusMembership[]
  applications AdmissionApplication[]
  feeHeads     FeeHead[]
  feeStructures FeeStructure[]
  invoices     Invoice[]
  payments     Payment[]
  receipts     Receipt[]
  staff        Staff[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

model CampusMembership {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId  String
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campusId, userId])
  @@index([schoolId])
}

model Subject {
  id        String         @id @default(cuid())
  schoolId  String
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String         @default("")
  enabled   Boolean        @default(true)
  classes   ClassSubject[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassSubject {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
}

model AdmissionForm {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String   @default("Default admission form")
  fields    Json
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model FeeItem {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  amountPkr Int      @default(0)
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolSequence {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind      String
  year      Int
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, kind, year])
  @@index([schoolId])
}

model AdmissionApplication {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationNo      String
  status             AdmissionStatus  @default(DRAFT)
  firstName          String           @default("")
  lastName           String           @default("")
  middleName         String           @default("")
  gender             String           @default("")
  dateOfBirth        DateTime?
  cnic               String           @default("")
  bloodGroup         String           @default("")
  nationality        String           @default("Pakistani")
  address            String           @default("")
  photoUrl           String           @default("")
  extra              Json             @default("{}")
  yearId             String?
  year               AcademicYear?    @relation(fields: [yearId], references: [id], onDelete: SetNull)
  campusId           String?
  campus             Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  className          String           @default("")
  section            String           @default("A")
  targetClassId      String?
  targetClass        Class?           @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  studentType        String           @default("new")
  previousSchool     String           @default("")
  previousClass      String           @default("")
  previousYear       String           @default("")
  previousResult     String           @default("")
  previousPct        String           @default("")
  transferNotes      String           @default("")
  guardianId         String?
  guardian           Guardian?        @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  studentId          String?
  student            Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  family             Json             @default("{}")
  feeQuotes          Json             @default("[]")
  wizardStep         Int              @default(1)
  createdById        String?
  createdBy          User?            @relation("ApplicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assessmentMode     AssessmentMode   @default(NONE)
  interviewAt        DateTime?
  interviewer        String           @default("")
  interviewNotes     String           @default("")
  recommendation     String           @default("")
  decisionNote       String           @default("")
  submittedAt        DateTime?
  decidedAt          DateTime?
  confirmedAt        DateTime?
  scores             AdmissionTestScore[]
  invoices           Invoice[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([schoolId, applicationNo])
  @@index([schoolId, status])
  @@index([schoolId, applicationNo])
  @@index([createdById])
}

model AdmissionTestScore {
  id            String                 @id @default(cuid())
  applicationId String
  application   AdmissionApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject       String
  maxMarks      Int
  obtainedMarks Int
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([applicationId])
}

model SchoolDocument {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ownerType  String
  ownerId    String
  kind       String
  label      String
  required   Boolean  @default(true)
  url        String   @default("")
  uploadedBy String?
  uploader   User?    @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId, ownerType, ownerId])
}

model CommunicationLog {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        CommunicationType
  recipient   String             @default("")
  subject     String             @default("")
  body        String             @default("")
  status      String             @default("logged")
  sentById    String?
  sentBy      User?              @relation("CommunicationAuthor", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([schoolId, studentId])
}

model SchoolClaim {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAtSchool String
  whatsapp    String
  note        String   @default("")
  status      String   @default("PENDING")
  rejectReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  inviterId   String
  inviter     User      @relation("Inviter", fields: [inviterId], references: [id])
  acceptedById String?
  acceptedBy  User?     @relation("AcceptedBy", fields: [acceptedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, classId, subject])
  @@index([schoolId])
}

model TimetablePeriod {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  startTime String
  endTime   String
  isBreak   Boolean           @default(false)
  sortOrder Int
  lessons   TimetableLesson[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([schoolId])
}

model TimetableLesson {
  id        String          @id @default(cuid())
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  periodId  String
  period    TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  weekday   Int
  subject   String
  override  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([classId, weekday, periodId])
  @@index([schoolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, entity, entityId])
}

model Exam {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId    String?
  year      AcademicYear? @relation(fields: [yearId], references: [id], onDelete: SetNull)
  name      String
  heldOn    DateTime      @db.Date
  results   ExamResult[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([schoolId, heldOn])
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       String   @default("")
  totalMarks    Int
  obtainedMarks Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId, subject])
  @@index([studentId])
}
