}

model SchoolClaim {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleAtSchool String
  whatsapp     String
  note         String   @default("")
  status       String   @default("PENDING")
  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([schoolId])
  @@index([userId])
}

model Invite {
  id           String    @id @default(cuid())
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String
  role         Role
  token        String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  inviterId    String
  inviter      User      @relation("Inviter", fields: [inviterId], references: [id])
  acceptedById String?
  acceptedBy   User?     @relation("AcceptedBy", fields: [acceptedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, classId, subject])
  @@index([schoolId])
}

model TimetablePeriod {
  id        String            @id @default(cuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  label     String
  startTime String
  endTime   String
  isBreak   Boolean           @default(false)
  sortOrder Int
  lessons   TimetableLesson[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([schoolId])
}

model TimetableLesson {
  id        String          @id @default(cuid())
  schoolId  String
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  periodId  String
  period    TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  weekday   Int
  subject   String
  override  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([classId, weekday, periodId])
  @@index([schoolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, entity, entityId])
}

enum ExamKind {
  EXAM
  QUIZ
  ASSIGNMENT
  PRACTICAL
  VIVA
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  MARKING
  COMPLETED
  PUBLISHED
}

enum PaperStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
}

enum MarkAttendance {
  PRESENT
  ABSENT
  MEDICAL
  EXEMPT
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResultScope {
  EXAM
  TERM
  ANNUAL
}

model Term {
  id            String         @id @default(cuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId        String
  year          AcademicYear   @relation(fields: [yearId], references: [id], onDelete: Cascade)
  name          String
  startsOn      DateTime       @db.Date
  endsOn        DateTime       @db.Date
  sortOrder     Int            @default(0)
  /// Share of this term in the annual result.
  weight        Float          @default(50)
  exams         Exam[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  syllabusUnits SyllabusUnit[]

  @@index([schoolId, yearId])
}

model GradingScale {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  /// [{ grade, minPct, gpa, remark, isFail }] sorted by minPct descending.
  bands     Json     @default("[]")
  exams     Exam[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model ExamSettings {
  id                  String   @id @default(cuid())
  schoolId            String   @unique
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  overallPassPct      Float    @default(33)
  subjectPassRequired Boolean  @default(true)
  maxFailSubjects     Int      @default(0)
  graceMarks          Float    @default(0)
  decimals            Int      @default(1)
  absentCountsAsZero  Boolean  @default(true)
  /// Share of quizzes/assignments/practicals/viva inside a term result; exams share the rest.
  assessmentWeight    Float    @default(0)
  rankMethod          String   @default("DENSE")
  rankScope           String   @default("SECTION")
  rankOnlyPassed      Boolean  @default(false)
  showRank            Boolean  @default(true)
  atRiskPct           Float    @default(40)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ReportCardTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  layout    String   @default("CLASSIC")
  isDefault Boolean  @default(false)
  /// { showRank, showGpa, showAttendance, showRemarks, showGradeLegend, showBreakdown, headerNote, signatures: string[] }
  options   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Exam {
  id                  String          @id @default(cuid())
  schoolId            String
  school              School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId              String
  year                AcademicYear    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  termId              String?
  term                Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  gradingScaleId      String?
  gradingScale        GradingScale?   @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  kind                ExamKind        @default(EXAM)
  name                String
  code                String          @default("")
  status              ExamStatus      @default(DRAFT)
  startsOn            DateTime        @db.Date
  endsOn              DateTime        @db.Date
  /// Weight of this exam inside its term result (relative to other exams of the same kind group).
  weight              Float           @default(100)
  includeInReportCard Boolean         @default(true)
  instructions        String          @default("")
  createdById         String?
  publishedAt         DateTime?
  papers              ExamPaper[]
  results             StudentResult[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  questionPapers      QuestionPaper[]

  @@index([schoolId, yearId, kind])
  @@index([schoolId, startsOn])
}

model ExamPaper {
  id            String           @id @default(cuid())
  schoolId      String
  examId        String
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId       String
  class         Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date          DateTime?        @db.Date
  startTime     String           @default("")
  endTime       String           @default("")
  room          String           @default("")
  invigilatorId String?
  invigilator   Staff?           @relation(fields: [invigilatorId], references: [id], onDelete: SetNull)
  maxMarks      Float            @default(100)
  passMarks     Float            @default(33)
  status        PaperStatus      @default(NOT_STARTED)
  enteredById   String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String           @default("")
  marks         ExamMark[]
  corrections   MarkCorrection[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  topics        ExamPaperTopic[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId, status])
  @@index([classId])
}

model ExamMark {
  id         String         @id @default(cuid())
  schoolId   String
  paperId    String
  paper      ExamPaper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks      Float?
  attendance MarkAttendance @default(PRESENT)
  remark     String         @default("")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([paperId, studentId])
  @@index([studentId])
}

model MarkCorrection {
  id            String           @id @default(cuid())
  schoolId      String
  paperId       String
  paper         ExamPaper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  oldMarks      Float?
  newMarks      Float?
  oldAttendance MarkAttendance   @default(PRESENT)
  newAttendance MarkAttendance   @default(PRESENT)
  reason        String
  status        CorrectionStatus @default(PENDING)
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([schoolId, status])
}

model StudentResult {
  id              String       @id @default(cuid())
  schoolId        String
  yearId          String
  year            AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  scope           ResultScope
  /// examId, termId or yearId depending on scope.
  scopeKey        String
  examId          String?
  exam            Exam?        @relation(fields: [examId], references: [id], onDelete: Cascade)
  termId          String?
  classId         String
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalObtained   Float
  totalMax        Float
  percentage      Float
  grade           String       @default("")
  gpa             Float?
  rank            Int?
  passed          Boolean
  failedSubjects  Int          @default(0)
  /// [{ subjectId, name, obtained, max, pct, grade, passed, attendance, parts? }]
  subjects        Json         @default("[]")
  attendancePct   Float?
  teacherRemark   String       @default("")
  principalRemark String       @default("")
  publishedAt     DateTime?
  computedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([scope, scopeKey, studentId])
  @@index([schoolId, yearId, scope])
  @@index([studentId])
  @@index([classId])
}

enum TopicProgress {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

/// Scheme of work / annual syllabus: one per grade + subject per academic year, shared by every section of the grade.
model Syllabus {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  yearId          String
  year            AcademicYear    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  /// Class name without the section, e.g. "Grade 5".
  gradeName       String
  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  overview        String          @default("")
  assessmentNotes String          @default("")
  resources       String          @default("")
  updatedById     String?
  units           SyllabusUnit[]
  topics          SyllabusTopic[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([yearId, gradeName, subjectId])
  @@index([schoolId, yearId])
}

model SyllabusUnit {
  id          String          @id @default(cuid())
  syllabusId  String
  syllabus    Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  termId      String?
  term        Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  plannedFrom DateTime?       @db.Date
  plannedTo   DateTime?       @db.Date
  sortOrder   Int             @default(0)
  topics      SyllabusTopic[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([syllabusId, sortOrder])
}

model SyllabusTopic {
  id             String           @id @default(cuid())
  syllabusId     String
  syllabus       Syllabus         @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  unitId         String
  unit           SyllabusUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title          String
  objectives     String           @default("")
  resources      String           @default("")
  plannedPeriods Int              @default(1)
  sortOrder      Int              @default(0)
  progress       TopicProgress    @default(PLANNED)
  completedOn    DateTime?        @db.Date
  /// A topic with any exam link is locked: it can't be edited, moved to another unit or deleted.
  examLinks      ExamPaperTopic[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([unitId, sortOrder])
  @@index([syllabusId])
}

/// Syllabus topics an exam paper covers. NoAction (not Restrict) so deleting a whole exam, year or school still cascades.
model ExamPaperTopic {
  paperId String
  paper   ExamPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  topicId String
  topic   SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: NoAction)

  @@id([paperId, topicId])
  @@index([topicId])
}

enum QuestionPaperStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  SHORT
  LONG
  TRANSLATION
  WRITING
  COMPREHENSION
  MATCH
  CUSTOM
}

/// The question paper for one exam, grade and subject. Every section of the grade sits the same paper.
model QuestionPaper {
  id              String               @id @default(cuid())
  schoolId        String
  school          School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam                 @relation(fields: [examId], references: [id], onDelete: Cascade)
  gradeName       String
  subjectId       String
  subject         Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title           String               @default("")
  instructions    String               @default("")
  durationMinutes Int                  @default(60)
  status          QuestionPaperStatus  @default(DRAFT)
  /// Marks a student can score: recalculated on every change (attempt-any-N sections count N questions).
  totalMarks      Float                @default(0)
  createdById     String?
  updatedById     String?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String               @default("")
  sections        QuestionSection[]
  prints          QuestionPaperPrint[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([examId, gradeName, subjectId])
  @@index([schoolId, status])
}

model QuestionSection {
  id           String        @id @default(cuid())
  paperId      String
  paper        QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title        String
  type         QuestionType
  instructions String        @default("")
  /// Reading passage for COMPREHENSION sections.
  passage      String        @default("")
  /// Right-to-left text (Urdu, Arabic).
  rtl          Boolean       @default(false)
  /// "Attempt any N": students answer N of the questions.
  attemptCount Int?
  sortOrder    Int           @default(0)
  questions    Question[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([paperId, sortOrder])
}

model Question {
  id          String          @id @default(cuid())
  sectionId   String
  section     QuestionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text        String
  marks       Float           @default(1)
  /// MCQ: string[] of options. MATCH: [{ left, right }] pairs.
  options     Json            @default("[]")
  /// MCQ: option index ("0", "1", …). TRUE_FALSE: "TRUE" or "FALSE". Others: model answer for the answer key.
  answer      String          @default("")
  /// Ruled answer lines printed under the question (0 = none).
  answerLines Int             @default(0)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sectionId, sortOrder])
}

/// Every time an admin prints a paper: who, how many copies, for which class.
model QuestionPaperPrint {
  id          String        @id @default(cuid())
  schoolId    String
  paperId     String
  paper       QuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  classId     String?
  classLabel  String        @default("")
  copies      Int
  answerKey   Boolean       @default(false)
  printedById String
  createdAt   DateTime      @default(now())

  @@index([paperId])
}

enum DiaryKind {
  HOMEWORK
  CLASSWORK
  NOTE
}

/// What a teacher wants a class (and its parents) to know for a day: homework, classwork or a note.
model DiaryEntry {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campusId      String?
  campus        Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  yearId        String
  year          AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  classId       String
  class         Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// Null for a class-wide note that is not about one subject.
  subjectId     String?
  subject       Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  date          DateTime     @db.Date
  kind          DiaryKind    @default(HOMEWORK)
  title         String       @default("")
  body          String
  dueOn         DateTime?    @db.Date
  imageUrl      String       @default("")
  authorStaffId String?
  author        Staff?       @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId, classId, date])
  @@index([schoolId, date])
  @@index([authorStaffId, date])
}

enum NoticeAudience {
  ALL
  CLASSES
}

/// A school notice for everyone, or for chosen classes. Parents read these in their portal.
model Notice {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Null means every campus.
  campusId    String?
  campus      Campus?        @relation(fields: [campusId], references: [id], onDelete: SetNull)
  title       String
  body        String
  audience    NoticeAudience @default(ALL)
  /// Class ids when audience is CLASSES.
  classIds    Json           @default("[]")
  pinned      Boolean        @default(false)
  publishedAt DateTime       @default(now())
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([schoolId, publishedAt])
}

/// A parent or guardian who signs in with their phone number. One per phone, across every school.
/// Their children are every student linked to a Guardian with the same normalized phone.
model ParentUser {
  id         String         @id @default(cuid())
  phoneNorm  String         @unique
  name       String         @default("")
  locale     String         @default("en")
  lastSeenAt DateTime?
  devices    ParentDevice[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

/// A phone or browser that has proved it owns the number. The token is shown once; only its hash is kept.
model ParentDevice {
  id         String     @id @default(cuid())
  parentId   String
  parent     ParentUser @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash  String     @unique
  label      String     @default("")
  lastSeenAt DateTime   @default(now())
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  @@index([parentId])
}

/// One sign-in code sent to a phone. `sent` is false when the number belongs to no guardian, so it still counts toward rate limits.
model OtpChallenge {
  id         String    @id @default(cuid())
  phoneNorm  String
  codeHash   String
  sent       Boolean   @default(true)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneNorm, createdAt])
}
