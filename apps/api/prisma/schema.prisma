  recipient String            @default("")
  subject   String            @default("")
  body      String            @default("")
  status    String            @default("logged")
  sentById  String?
  sentBy    User?             @relation("CommunicationAuthor", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

