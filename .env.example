# Docker Compose (pnpm db:up):
# DATABASE_URL="postgresql://wellrun:wellrun@localhost:5432/wellrun_school?schema=public"
# Local Prisma Postgres (pnpm --filter @wellrun/api exec prisma dev --name wellrun-school --detach):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/template1?schema=public&sslmode=disable&pgbouncer=true"
# Neon / hosted Postgres (put the real URI in apps/api/.env, not here):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Azure Postgres (put the real URI in .env, not here):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Azure SQL (put the real URI in .env, not here):
# DATABASE_URL="sqlserver://HOST:1433;database=DB;user=USER;password=PASSWORD;encrypt=true"
JWT_SECRET="change-me-in-production"
API_PORT=3000
# Comma-separated console origins. Omit on Render to allow any origin, or set "*" .
# CORS_ORIGINS="http://localhost:5173,https://your-console.vercel.app"
NEXT_PUBLIC_API_URL="http://localhost:3000"
VITE_API_URL="http://localhost:3000"
# Per-request timing logs (apps/api/logs/requests). Default on locally; set 0 to disable. Production is off unless 1.
# REQUEST_TRACE=1
