# Docker Compose (pnpm db:up):
# DATABASE_URL="postgresql://wellrun:wellrun@localhost:5432/wellrun_school?schema=public"
# Local Prisma Postgres (pnpm --filter @wellrun/api exec prisma dev --name wellrun-school --detach):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/template1?schema=public&sslmode=disable&pgbouncer=true"
# Neon / hosted Postgres (put the real URI in apps/api/.env, not here):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
JWT_SECRET="change-me-in-production"
API_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000"
VITE_API_URL="http://localhost:3000"
